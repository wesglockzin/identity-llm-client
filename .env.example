# Required settings have no default; set them before use.
# Base URL of the Ollama (or OpenAI-compatible) server, e.g. http://localhost:11434
OLLAMA_BASE_URL=
# Model names per role (required), e.g. a model you have pulled
LLM_MODEL_REASON=
LLM_MODEL_FAST=
LLM_MODEL_EMBED=
# Optional settings; the values shown are the defaults.
# Seconds allowed for chat and embedding requests
LLM_TIMEOUT=300
# Seconds allowed for health()
LLM_HEALTH_TIMEOUT=5
# Bearer token sent as the Authorization header; unset sends none
# LLM_API_KEY=
# Replaces the built-in IAM-analyst system prompt; unset or empty keeps the built-in
# LLM_SYSTEM_PROMPT=
