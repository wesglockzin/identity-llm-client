# All settings are optional; the values shown are the defaults.
# Base URL of the Ollama (or OpenAI-compatible) server
OLLAMA_BASE_URL=http://localhost:11434
# Model names per role
LLM_MODEL_REASON=qwen2.5:72b
LLM_MODEL_FAST=qwen2.5-coder:32b
LLM_MODEL_EMBED=nomic-embed-text
# Seconds allowed for chat and embedding requests
LLM_TIMEOUT=300
# Seconds allowed for health()
LLM_HEALTH_TIMEOUT=5
# Bearer token sent as the Authorization header; unset sends none
# LLM_API_KEY=
# Replaces the built-in IAM-analyst system prompt; unset keeps the built-in
# LLM_SYSTEM_PROMPT=
